# Copie para .env e preencha (não commite o .env)

# IA (dev local — em produção use ANTHROPIC_API_KEY no Vercel)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-sua_chave_aqui

# Supabase (obrigatório para login)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Login: false = exige conta real | true = modo teste (sem tela de login)
EXPO_PUBLIC_SKIP_AUTH=false

# Vercel (variáveis de servidor — painel do Vercel, não no .env local):
# SKIP_AUTH=false
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua_anon_key_aqui
# ANTHROPIC_API_KEY=sua_chave_aqui
# OPENAI_API_KEY=sua_chave_aqui

# OpenAI (TTS — voz masculina via nuvem, gpt-4o-mini-tts / onyx)
OPENAI_API_KEY=sua_chave_aqui
