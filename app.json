{
  "expo": {
    "name": "Argos",
    "slug": "argos-assistant",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050810",
    "scheme": "argos",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050810"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o Argos use sua localização para disparar automações enquanto o app estiver aberto."
        }
      ],
      "@react-native-voice/voice",
      "./plugins/withForegroundService",
      [
        "react-native-vosk",
        {
          "models": ["./assets/model-pt"],
          "iOSMicrophonePermission": "Argos precisa do microfone para reconhecer seus comandos de voz."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "enableProguardInReleaseBuilds": false
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Argos precisa do microfone para reconhecer seus comandos de voz.",
        "NSSpeechRecognitionUsageDescription": "Argos usa reconhecimento de voz para entender seus comandos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050810"
      },
      "package": "com.masya.argos",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#050810",
      "themeColor": "#050810"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b55e65c0-b79c-4867-a812-6c7cc7c8c349",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "skipAuth": false,
      "router": {},
      "eas": {
        "projectId": "b55e65c0-b79c-4867-a812-6c7cc7c8c349"
      }
    }
  }
}
